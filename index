<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Operativo - Servitel+ / Tecnicable</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome para iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-[#121212] text-gray-300 font-sans antialiased">

    <!-- CONTENEDOR DE LOGIN (Se oculta al iniciar sesión) -->
    <div id="login-container" class="fixed inset-0 bg-[#121212] z-50 flex items-center justify-center hidden">
        <div class="bg-[#1a1a1a] border border-gray-800 p-8 rounded-2xl shadow-xl w-full max-w-md">
            <div class="text-center mb-6">
                <h2 class="text-white text-2xl font-bold">SERVITEL+</h2>
                <p class="text-xs text-gray-400 mt-1">Acceso al Sistema Operativo</p>
            </div>
            <div id="error-msg" class="hidden mb-4 p-3 bg-red-900/40 border border-red-800 text-red-400 text-xs rounded-lg"></div>
            <form id="login-form" class="space-y-4">
                <div>
                    <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1 font-medium">Correo Electrónico</label>
                    <input type="email" id="email" required class="w-full bg-[#222222] border border-gray-800 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-blue-600 text-sm">
                </div>
                <div>
                    <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1 font-medium">Contraseña</label>
                    <input type="password" id="password" required class="w-full bg-[#222222] border border-gray-800 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-blue-600 text-sm">
                </div>
                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2.5 rounded-lg transition-colors text-sm">
                    Entrar al Sistema
                </button>
            </form>
        </div>
    </div>

    <!-- CONTENEDOR PRINCIPAL DEL DASHBOARD (Se oculta si no hay sesión) -->
    <div id="app-container" class="flex h-screen overflow-hidden hidden">
        
        <!-- SIDEBAR IZQUIERDO -->
        <aside class="w-64 bg-[#1e1e1e] border-r border-gray-800 flex flex-col justify-between hidden md:flex">
            <div>
                <div class="flex items-center justify-center h-16 bg-[#181818] border-b border-gray-800">
                    <span class="text-white font-bold text-lg tracking-wider">SERVITEL+ <span class="text-blue-500 text-xs">Admin</span></span>
                </div>
                <nav class="p-4 space-y-1">
                    <a href="#" class="flex items-center gap-3 px-4 py-2.5 rounded-lg bg-blue-600 text-white font-medium text-sm">
                        <i class="fa-solid fa-chart-pie"></i> Dashboard
                    </a>
                    <a href="#" class="flex items-center gap-3 px-4 py-2.5 rounded-lg hover:bg-gray-800 text-gray-400 hover:text-white text-sm transition-colors">
                        <i class="fa-solid fa-users"></i> Clientes Ingresados
                    </a>
                    <a href="#" class="flex items-center gap-3 px-4 py-2.5 rounded-lg hover:bg-gray-800 text-gray-400 hover:text-white text-sm transition-colors">
                        <i class="fa-solid fa-globe"></i> Clientes Web
                    </a>
                    <a href="#" class="flex items-center gap-3 px-4 py-2.5 rounded-lg hover:bg-gray-800 text-gray-400 hover:text-white text-sm transition-colors">
                        <i class="fa-solid fa-id-card-clip"></i> Promotores
                    </a>
                    <a href="#" class="flex items-center gap-3 px-4 py-2.5 rounded-lg hover:bg-gray-800 text-gray-400 hover:text-white text-sm transition-colors">
                        <i class="fa-solid fa-map-location-dot"></i> Opción de Censo
                    </a>
                </nav>
            </div>
            <div class="p-4 border-t border-gray-800 bg-[#181818] text-xs flex items-center justify-between">
                <span class="truncate text-gray-400"><i class="fa-solid fa-user-circle text-blue-500 mr-1"></i> <span id="user-email-display">Usuario</span></span>
                <button id="btn-logout" class="text-red-400 hover:text-red-300 cursor-pointer" title="Cerrar sesión"><i class="fa-solid fa-right-from-bracket"></i></button>
            </div>
        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <div class="flex-1 flex flex-col overflow-y-auto">
            <header class="h-16 bg-[#181818] border-b border-gray-800 flex items-center justify-between px-6">
                <h1 class="text-white font-semibold text-lg">Panel de Control General</h1>
                <span class="bg-emerald-900/40 text-emerald-400 border border-emerald-800/50 px-3 py-1 rounded-full text-xs font-medium">Conectado a Firebase</span>
            </header>

            <main class="p-6 space-y-6">
                <!-- TARJETAS DE ESTADÍSTICAS -->
                <div>
                    <h2 class="text-white text-md font-semibold mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-user-plus text-blue-500"></i> Estadísticas de Ingresos
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="bg-[#1a1a1a] border border-gray-800 rounded-xl p-5 flex items-center justify-between shadow-md">
                            <div>
                                <p class="text-xs uppercase tracking-wider text-gray-400 font-medium">Ingresos Hoy</p>
                                <h3 id="stat-hoy" class="text-3xl font-bold text-white mt-1">...</h3>
                            </div>
                            <div class="w-12 h-12 rounded-lg bg-blue-600/20 text-blue-500 flex items-center justify-center text-xl"><i class="fa-solid fa-bolt"></i></div>
                        </div>
                        <div class="bg-[#1a1a1a] border border-gray-800 rounded-xl p-5 flex items-center justify-between shadow-md">
                            <div>
                                <p class="text-xs uppercase tracking-wider text-gray-400 font-medium">Registros Página Web</p>
                                <h3 id="stat-web" class="text-3xl font-bold text-white mt-1">...</h3>
                            </div>
                            <div class="w-12 h-12 rounded-lg bg-cyan-600/20 text-cyan-400 flex items-center justify-center text-xl"><i class="fa-solid fa-globe"></i></div>
                        </div>
                        <div class="bg-[#1a1a1a] border border-gray-800 rounded-xl p-5 flex items-center justify-between shadow-md">
                            <div>
                                <p class="text-xs uppercase tracking-wider text-gray-400 font-medium">Total Base Activa</p>
                                <h3 id="stat-total" class="text-3xl font-bold text-white mt-1">...</h3>
                            </div>
                            <div class="w-12 h-12 rounded-lg bg-emerald-600/20 text-emerald-500 flex items-center justify-center text-xl"><i class="fa-solid fa-users"></i></div>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN SECUNDARIA -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-[#1a1a1a] border border-gray-800 rounded-xl p-5 shadow-md">
                        <h3 class="text-white font-medium text-sm flex items-center gap-2 mb-4">
                            <i class="fa-solid fa-id-badge text-purple-400"></i> Clientes por Promotor
                        </h3>
                        <div id="promotores-list" class="space-y-3 text-sm text-gray-400">Cargando registros...</div>
                    </div>
                    <div class="bg-[#1a1a1a] border border-gray-800 rounded-xl p-5 shadow-md">
                        <h3 class="text-white font-medium text-sm flex items-center gap-2 mb-4">
                            <i class="fa-solid fa-map-location-dot text-amber-400"></i> Opción de Censo (Zonas)
                        </h3>
                        <div id="censo-list" class="space-y-3 text-sm text-gray-400">Cargando datos...</div>
                    </div>
                </div>
            </main>
            
            <footer class="mt-auto py-4 px-6 border-t border-gray-800 text-center text-xs text-gray-500">
                Tecnicable C.A. / Servitel+ • Sistema Operativo Integrado
            </footer>
        </div>
    </div>

    <!-- SCRIPT LOGICA Y FIREBASE -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getAuth, signInWithEmailAndPassword, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
        import { getFirestore, collection, getDocs } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyCaI5NPapzEe1jK8EfZrnTW8lEytfy4eR4",
            authDomain: "formulario-9b119.firebaseapp.com",
            projectId: "formulario-9b119",
            storageBucket: "formulario-9b119.firebasestorage.app",
            messagingSenderId: "648279847643",
            appId: "1:648279847643:web:802107ded1f0f5957f52fe",
            measurementId: "G-VSFYQB6FQ9"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        const loginContainer = document.getElementById('login-container');
        const appContainer = document.getElementById('app-container');
        const loginForm = document.getElementById('login-form');
        const errorMsg = document.getElementById('error-msg');

        // Control de sesión en tiempo real
        onAuthStateChanged(auth, (user) => {
            if (!user) {
                appContainer.classList.add('hidden');
                loginContainer.classList.remove('hidden');
            } else {
                loginContainer.classList.add('hidden');
                appContainer.classList.remove('hidden');
                document.getElementById('user-email-display').innerText = user.email;
                cargarDatosDashboard();
            }
        });

        // Evento de Login
        loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            try {
                errorMsg.classList.add('hidden');
                await signInWithEmailAndPassword(auth, email, password);
            } catch (error) {
                errorMsg.innerText = "Error de acceso: Correo o contraseña incorrectos.";
                errorMsg.classList.remove('hidden');
            }
        });

        // Botón de Cierre de Sesión
        document.getElementById('btn-logout').addEventListener('click', () => {
            signOut(auth);
        });

        // Función para leer Firestore y calcular métricas
        async function cargarDatosDashboard() {
            try {
                const querySnapshot = await getDocs(collection(db, "clientes"));
                let total = querySnapshot.size;
                let hoyCount = 0;
                let webCount = 0;
                let promotoresMap = {};
                let censoCount = 0;

                const hoyStr = new Date().toISOString().split('T')[0];

                querySnapshot.forEach((doc) => {
                    const data = doc.data();
                    if (data.fechaRegistro === hoyStr || (data.fechaRegistro && data.fechaRegistro.startsWith(hoyStr))) {
                        hoyCount++;
                    }
                    if (data.origen === "web" || data.origen === "pagina_web") {
                        webCount++;
                    }
                    if (data.promotor) {
                        promotoresMap[data.promotor] = (promotoresMap[data.promotor] || 0) + 1;
                    }
                    if (data.tipo === "censo" || data.origen === "censo") {
                        censoCount++;
                    }
                });

                document.getElementById('stat-total').innerText = total;
                document.getElementById('stat-hoy').innerText = hoyCount;
                document.getElementById('stat-web').innerText = webCount;

                const promContainer = document.getElementById('promotores-list');
                if (Object.keys(promotoresMap).length > 0) {
                    promContainer.innerHTML = Object.entries(promotoresMap).map(([prom, count]) => `
                        <div class="flex items-center justify-between p-2.5 bg-[#222222] rounded-lg">
                            <span class="text-white font-medium">${prom}</span>
                            <span class="bg-purple-600/20 text-purple-400 px-2.5 py-0.5 rounded text-xs font-bold">${count} registros</span>
                        </div>
                    `).join('');
                } else {
                    promContainer.innerHTML = `<p class="text-gray-500">No hay registros de promotores todavía.</p>`;
                }

                document.getElementById('censo-list').innerHTML = `
                    <div class="p-3 bg-[#222222] rounded-lg flex items-center justify-between">
                        <span>Total de registros bajo modalidad Censo:</span>
                        <span class="text-amber-400 font-bold text-lg">${censoCount}</span>
                    </div>
                `;
            } catch (error) {
                console.error("Error al consultar la base de datos:", error);
            }
        }
    </script>
</body>
</html>
